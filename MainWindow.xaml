<Window x:Class="API_Tester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:API_Tester"
        mc:Ignorable="d"
        Title="API Tester" Height="450" Width="800">

    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <WrapPanel HorizontalAlignment="Center">
                <ComboBox x:Name="RequestTypeCBox" ItemsSource="{Binding RequestTypes}" SelectedItem="{Binding SelectedReqType}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Height="27" SelectedIndex="0">
                </ComboBox>
                <TextBox x:Name="RequestUrlTBox" HorizontalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" Text="{Binding ReqUrl}" VerticalAlignment="Top" Width="330" Height="27"/>
            </WrapPanel>
            <Button x:Name="SendRequestBtn" Content="Button" HorizontalAlignment="Center" Margin="0,10,0,0" Height="36" VerticalAlignment="Top" Width="132" Command="{Binding SendRequestCommand}"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{Binding ResponseBody}" Background="Gray" Foreground="Wheat" MinHeight="125" MaxHeight="225" Width="800">

        </TextBlock>
    </Grid>
</Window>
