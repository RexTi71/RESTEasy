<Window x:Class="API_Tester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:API_Tester"
        mc:Ignorable="d"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Title="API Tester" Height="900" Width="1600" Background="{DynamicResource Dark-Amethyst-Brush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="5"
                      CornerRadius="0"
                      GlassFrameThickness="1"/>
    </WindowChrome.WindowChrome>
    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="TopBar"
              Grid.Row="0"
              Background="{DynamicResource Indigo-Ink-Brush}"
              MouseDown="TopBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                   HorizontalAlignment="Left"
                   Padding="10,0,0,0"
                   FontSize="32"
                   FontFamily="{DynamicResource GoogleSansFont}"
                   Foreground="{DynamicResource Mauve-Brush}" VerticalAlignment="Center"
                   ><Bold>REST</Bold>Easy</TextBlock>
            <Button Grid.Column="1"
                    Style="{DynamicResource ModernBttn}"
                    BorderThickness="0"
                    FontWeight="Bold"
                    Click="Minimize_Window_Click"
                    WindowChrome.IsHitTestVisibleInChrome="True">-</Button>
            <Button Grid.Column="2"
                    Style="{DynamicResource ModernBttn}"
                    BorderThickness="0"
                    FontWeight="Bold"
                    Click="Maximize_Window_Click"
                    WindowChrome.IsHitTestVisibleInChrome="True">o</Button>
            <Button Grid.Column="3"
                    Style="{DynamicResource ModernBttn}"
                    BorderThickness="0"
                    FontWeight="Bold"
                    Click="Close_Window_Click"
                    WindowChrome.IsHitTestVisibleInChrome="True">x</Button>
        </Grid>
        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ComboBox ItemContainerStyle="{DynamicResource ModernComboBoxItem}" Template="{DynamicResource ModernComboBox}" x:Name="RequestTypeCBox"
                      ItemsSource="{Binding RequestTypes}"
                      FontFamily="{DynamicResource GoogleSansFont}"
                      SelectedItem="{Binding SelectedReqType}"
                      Width="90"
                      Height="27" Foreground="{DynamicResource Mauve-Brush}">
            </ComboBox>
            <TextBox x:Name="RequestUrlTBox"
                     Style="{DynamicResource ModernTextBox}"
                     FontFamily="{DynamicResource GoogleSansFont}"
                     Margin="10,0,0,0"
                     TextWrapping="Wrap" Text="{Binding ReqUrl}"
                     Width="550" Height="27" 
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center">
                <TextBox.Resources>

                </TextBox.Resources>
            </TextBox>
            <Button x:Name="SendRequestBtn"
                    Content="Send"
                    Style="{DynamicResource ModernBttn}"
                    FontSize="20"
                    HorizontalAlignment="Center"
                    Margin="10,0,0,0"
                    Height="27"
                    VerticalAlignment="Top"
                    Width="132"
                    Command="{Binding SendRequestCommand}"/>
        </WrapPanel>
        <TextBox Text="{Binding ReqPayload}"
                 Grid.Row="2"
                 Style="{DynamicResource ModernTextBox}"
                 FontFamily="Courier New"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 Background="Transparent"
                 Foreground="{DynamicResource Mauve-Brush}"
                 VerticalScrollBarVisibility="Hidden" Padding="10,10,0,0" BorderBrush="#FF240046" BorderThickness="0,2,0,2"/>
        <TextBox Grid.Row="3"
                   Text="{Binding ResponseBody}"
                   IsReadOnly="True"
                   TextWrapping="Wrap"
                   FontFamily="Courier New"
                   Background="Transparent"
                   BorderThickness="0"
                   Foreground="{StaticResource Mauve-Brush}"
                   MinHeight="125"
                   MaxHeight="450"
                   Width="1600" ScrollViewer.CanContentScroll="True"/>
        <Label x:Name="BodyLabel" Content="Body" HorizontalAlignment="Left" Margin="1298,139,0,0" Grid.Row="2" VerticalAlignment="Top" FontFamily="{DynamicResource GoogleSansFont}" FontSize="88" RenderTransformOrigin="0.5,0.5" FontWeight="Bold" Width="408" Opacity="0.25" Height="161" Grid.RowSpan="2" Background="#00000000" Foreground="#FF3C096C">
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="90"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>
        <Label x:Name="BodyLabel_Kopiuj" Content="Resp" HorizontalAlignment="Left" Margin="1298,108,0,0" Grid.Row="3" VerticalAlignment="Top" Foreground="#FF3C096C" FontFamily="{DynamicResource GoogleSansFont}" FontSize="88" RenderTransformOrigin="0.5,0.5" FontWeight="Bold" Width="382" Opacity="0.25" Height="161">
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="90"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>
    </Grid>
</Window>
