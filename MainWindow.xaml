<Window x:Class="API_Tester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:API_Tester"
        mc:Ignorable="d"
        Title="API Tester" Height="900" Width="1600">

    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ComboBox x:Name="RequestTypeCBox" ItemsSource="{Binding RequestTypes}" SelectedItem="{Binding SelectedReqType}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Height="27" SelectedIndex="0">
                </ComboBox>
                <TextBox x:Name="RequestUrlTBox" HorizontalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" Text="{Binding ReqUrl}" VerticalAlignment="Top" Width="330" Height="27"/>
            <Button x:Name="SendRequestBtn" Content="Button" HorizontalAlignment="Center" Margin="10,0,0,0" Height="27" VerticalAlignment="Top" Width="132" Command="{Binding SendRequestCommand}"/>
            </WrapPanel>
            <TextBox Text="{Binding ReqPayload}" Grid.Row="1" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"></TextBox>
        <TextBlock Grid.Row="2" Text="{Binding ResponseBody}" Background="Gray" Foreground="Wheat" MinHeight="125" MaxHeight="450" Width="1600">

        </TextBlock>
    </Grid>
</Window>
