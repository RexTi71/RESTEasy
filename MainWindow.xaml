<Window x:Class="API_Tester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:API_Tester"
        mc:Ignorable="d"
        Title="API Tester" Height="900" Width="1600">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#10002B"/>
            <Setter Property="Foreground" Value="#E0AAFF"/>
        </Style>

    </Window.Resources>
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#240046"/>
            <GradientStop Color="#3C096C" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ComboBox Template="{DynamicResource ModernComboBox}" x:Name="RequestTypeCBox"
                      ItemsSource="{Binding RequestTypes}"
                      FontFamily="{StaticResource GoogleSansFont}"
                      SelectedItem="{Binding SelectedReqType}"
                      Width="90"
                      Height="27" Foreground="{DynamicResource Mauve-Brush}">
            </ComboBox>
            <TextBox x:Name="RequestUrlTBox"
                     FontFamily="{StaticResource GoogleSansFont}"
                     Margin="10,0,0,0"
                     TextWrapping="Wrap" Text="{Binding ReqUrl}"
                     Width="330" Height="27" 
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"/>
            <Button x:Name="SendRequestBtn"
                    Content="Send"
                    Style="{DynamicResource ModernBttn}"
                    HorizontalAlignment="Center"
                    Margin="10,0,0,0"
                    Height="27"
                    VerticalAlignment="Top"
                    Width="132"
                    Command="{Binding SendRequestCommand}"/>
        </WrapPanel>
        <TextBox Text="{Binding ReqPayload}"
                 Grid.Row="1"
                 FontFamily="{StaticResource GoogleSansFont}"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Padding="10,10,0,0" BorderBrush="#FF240046" BorderThickness="0,1,0,1"/>
        <TextBlock Grid.Row="2"
                   Text="{Binding ResponseBody}"
                   FontFamily="Courier New"
                   Foreground="{StaticResource Mauve-Brush}"
                   MinHeight="125"
                   MaxHeight="450"
                   Width="1600" Background="#FF10002B" ScrollViewer.CanContentScroll="True"/>
        <Label x:Name="BodyLabel" Content="Body" HorizontalAlignment="Left" Margin="1308,153,0,0" Grid.Row="1" VerticalAlignment="Top" Foreground="#FF3C096C" FontFamily="{DynamicResource GoogleSansFont}" FontSize="88" RenderTransformOrigin="0.5,0.5" FontWeight="Bold" Width="418" Opacity="0.5">
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="90"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>
        <Label x:Name="BodyLabel_Kopiuj" Content="Resp" HorizontalAlignment="Left" Margin="1286,168,0,0" Grid.Row="2" VerticalAlignment="Top" Foreground="#FF3C096C" FontFamily="{DynamicResource GoogleSansFont}" FontSize="88" RenderTransformOrigin="0.5,0.5" FontWeight="Bold" Width="418" Opacity="0.5" Height="150">
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="90"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>
    </Grid>
</Window>
